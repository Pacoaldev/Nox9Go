# NOX9GO environment contract
# Copy to .env and fill in values.

# Optional. Leave these unset unless you need to override them.
#
# JWT_SECRET: if unset, a random secret is generated and persisted in the
# data dir on first start. Set it only to pin your own long random value.
# JWT_SECRET=
#
# INITIAL_PASSWORD: if unset, a random dashboard password is generated at first
# start and printed once; the first login with it forces a new one.
# INITIAL_PASSWORD=
#
# DATA_DIR: if unset, the per-platform default is used (%APPDATA%\nox9go on
# Windows, ~/.nox9go elsewhere).
# DATA_DIR=

# Server
PORT=20130

# OAuth client credentials
# Client IDs ship with public defaults for well-known clients (antigravity,
# gemini-cli, xai, codex, iflow, etc.) and normally need no change.
# Client SECRETS do not ship at all: a provider that requires one will fail to
# exchange the authorization code until you set it here. Register your own OAuth
# client with the provider and paste its secret. A real environment variable
# always wins over this file.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing. Same effect as the
# "Force Fallback" toggle in Settings -> Default Routing Strategy; upstream parity.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# TLS verification is mandatory. A request whose certificate does not verify
# fails, and nothing is retried with verification disabled.
#
# If you sit behind a proxy or antivirus that re-signs HTTPS, install its root
# CA in the system trust store (or in SSL_CERT_FILE). That is the supported fix.
#
# ALLOW_INSECURE_TLS=true or 1 is a deliberate escape hatch: it replays a
# failed-verification request once with verification disabled. Those requests
# carry your provider tokens and conversations, so anyone able to intercept the
# connection can read them. Leave it unset unless you accept that risk.
# ALLOW_INSECURE_TLS=true

# MiniMax Code account API signing secret (optional). If unset, built-in value used.
# MINIMAX_CODE_SIGN_SECRET=

# NOX9GO environment contract
# Copy to .env and fill in values.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/nox9go

# Server
PORT=20130

# OAuth client credentials
# Client IDs ship with public defaults for well-known clients (antigravity,
# gemini-cli, xai, codex, iflow, etc.) and normally need no change.
# Client SECRETS do not ship at all: a provider that requires one will fail to
# exchange the authorization code until you set it here. Register your own OAuth
# client with the provider and paste its secret.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing. Same effect as the
# "Force Fallback" toggle in Settings -> Default Routing Strategy; upstream parity.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# Set to true or 1 to forbid the insecure-TLS retry. By default a request that
# fails certificate verification is replayed once with verification disabled,
# which is what gets through a corporate proxy or antivirus that re-signs TLS.
# STRICT_SSL=true
